c:[["$","meta","0",{"charSet":"utf-8"}],["$","title","1",{"children":"About Axonova | Our Mission in AI Transformation"}],["$","meta","2",{"name":"description","content":"Learn about Axonova's mission to make AI practical, safe, and valuable for every business. Discover why our focus on practical application, governance, and end-to-end support makes us the partner of choice for AI adoption."}],["$","meta","3",{"name":"keywords","content":"About Axonova Consulting,AI consulting mission,Responsible AI firm,Why choose Axonova,Our AI strategy philosophy,Digital transformation agency"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","link","5",{"rel":"canonical","href":"https://www.axonova.com/about"}],["$","meta","6",{"property":"og:title","content":"Who We Are: The Axonova Story and AI Philosophy"}],["$","meta","7",{"property":"og:description","content":"We are built for your people and processes. Our methods embed governance and measurable business impact into every step of your AI journey."}],["$","meta","8",{"property":"og:url","content":"https://www.axonova.com/about"}],["$","meta","9",{"property":"og:site_name","content":"Axonova AI Consulting"}],["$","meta","10",{"property":"og:locale","content":"en_US"}],["$","meta","11",{"property":"og:image","content":"https://www.axonova.com/assets/img/og-about-us.jpg"}],["$","meta","12",{"property":"og:image:width","content":"1200"}],["$","meta","13",{"property":"og:image:height","content":"630"}],["$","meta","14",{"property":"og:image:alt","content":"Axonova Team and Mission Statement"}],["$","meta","15",{"property":"og:type","content":"website"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:creator","content":"@AxonovaOfficial"}],["$","meta","18",{"name":"twitter:title","content":"Practical, Safe, Measurable: The Axonova Difference"}],["$","meta","19",{"name":"twitter:description","content":"We focus on real tasks, real workflows, and real va